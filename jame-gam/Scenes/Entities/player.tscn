[gd_scene format=3 uid="uid://rcn35wjfl023"]

[sub_resource type="GDScript" id="GDScript_ft3ro"]
script/source = "extends CharacterBody2D

var accel : float = 8000
const maxSpeed : int = 15000

func _physics_process(delta: float) -> void:
	#Movement
	var direction = Input.get_axis(\"left\", \"right\")
	
	if direction:
		velocity.x = move_toward(velocity.x, maxSpeed * delta, accel * direction * delta)
		move_and_slide()
"

